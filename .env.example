# ==============================================================================
# BẢN MẪU BIẾN MÔI TRƯỜNG HỆ THỐNG ZT-SERVEROPS (.env.example)
# Quy tắc bảo mật: Sao chép tệp này thành .env và điền các giá trị thực tế.
# Tuyệt đối không commit tệp .env thật lên kho lưu trữ mã nguồn.
# ==============================================================================

# --- [1. MẶT PHẲNG ĐIỀU KHIỂN - CONTROL PLANE GATEWAY] ---
# Cổng và địa chỉ lắng nghe của Fastify Web Server
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
NODE_ENV=production

# Khóa bí mật ký số JSON Web Token (HMAC-SHA256)
# CHÚ THÍCH THIẾT LẬP (SETUP HOOK): Độ dài bắt buộc tối thiểu 32 ký tự để chống brute-force
JWT_SECRET=ThayDoiBangJWTNgauNhienToiThieu32KyTu
JWT_EXPIRES_IN=1d

# --- [2. CƠ SỞ DỮ LIỆU POSTGRESQL v3.1] ---
# Thông số kết nối CSDL và Connection Pool tới PostgreSQL
POSTGRES_USER=zt_admin
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
POSTGRES_DB=zt_serverops
# Kết nối runtime với quyền tối thiểu (zt_app)
DATABASE_URL=postgres://zt_app:REPLACE_WITH_RANDOM_APP_PASSWORD@postgres:5432/zt_serverops
# Kết nối migration với quyền quản trị DDL (zt_admin)
MIGRATION_DATABASE_URL=postgres://zt_admin:REPLACE_WITH_RANDOM_ADMIN_PASSWORD@postgres:5432/zt_serverops
# Kết nối bảo trì định kỳ với vai trò zt_maintenance (R3-05 Remediation)
MAINTENANCE_DATABASE_URL=postgres://zt_maintenance:REPLACE_WITH_RANDOM_MAINTENANCE_PASSWORD@postgres:5432/zt_serverops
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# --- [3. DỊCH VỤ WEB SSH BASTION PTY] ---
# Đường dẫn tệp khóa định danh riêng tư Ed25519 (phân quyền chmod 400)
BASTION_SSH_KEY_PATH=./keys/bastion_id_ed25519
BASTION_DEFAULT_USER=ztuser
BASTION_CONNECT_TIMEOUT_MS=10000

# --- [4. DỊCH VỤ QUÉT DỌN & PHÁT HIỆN SỰ CỐ (SWEEPER)] ---
# Chu kỳ quét kiểm tra trạng thái Liveness của các Endpoint Hosts (mili-giây)
SWEEPER_INTERVAL_MS=5000
# Ngưỡng thời gian không nhận được Telemetry Beacon để đánh dấu Node là OFFLINE (giây)
NODE_OFFLINE_THRESHOLD_SECONDS=30

# --- [5. DỊCH VỤ CẢNH BÁO ON-CALL TELEGRAM] ---
# Token tạo từ @BotFather (Tùy chọn khi bật tính năng thông báo)
TELEGRAM_BOT_TOKEN=
# Mã OTP dùng để ghép nối tài khoản Telegram với quyền nhận cảnh báo (để trống để tự sinh ngẫu nhiên)
# CHÚ THÍCH THIẾT LẬP: Nhập mã này trên điện thoại qua lệnh: /pair <MÃ_OTP>
TELEGRAM_PAIR_OTP=

# --- [6. MẠNG TRUYỀN DẪN NGẦM WIREGUARD] ---
WG_GATEWAY_IP=10.100.0.1
WG_SUBNET=10.100.0.0/24
WG_LISTEN_PORT=51820

# --- Classroom demo (no external Telegram messages) ---
NODE_STALE_THRESHOLD_SECONDS=15
CPU_ALERT_THRESHOLD_PERCENT=85
TELEGRAM_MODE=dry-run
TELEGRAM_REQUEST_TIMEOUT_MS=5000
# Generated by init-secrets.sh for a new env; demo.py also reads the token file.
NODE_ID_01=node-worker-01
NODE_TOKEN_01=
# Keep web console local; only UDP51820 is public by default.
PROXY_BIND_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
WG_BIND_IP=0.0.0.0
