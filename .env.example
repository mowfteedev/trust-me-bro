# ==============================================================================
# BẢN MẪU BIẾN MÔI TRƯỜNG HỆ THỐNG ZT-SERVEROPS (.env.example)
# Quy tắc bảo mật: Sao chép tệp này thành .env và điền các giá trị thực tế.
# Tuyệt đối không commit tệp .env thật lên kho lưu trữ mã nguồn.
# ==============================================================================

# --- [1. MẶT PHẲNG ĐIỀU KHIỂN - CONTROL PLANE GATEWAY] ---
# Cổng và địa chỉ lắng nghe của Fastify Web Server
GATEWAY_PORT=3000
GATEWAY_HOST=0.0.0.0
NODE_ENV=development

# Khóa bí mật ký số JSON Web Token (HMAC-SHA256)
# CHÚ THÍCH THIẾT LẬP (SETUP HOOK): Độ dài bắt buộc tối thiểu 32 ký tự để chống brute-force
JWT_SECRET=ThayDoiChuoiBiMatNayBangChuoiNgauNhienDaiToiThieu32KyTu!
JWT_EXPIRES_IN=1d

# --- [2. CƠ SỞ DỮ LIỆU POSTGRESQL v3.1] ---
# Chuỗi kết nối Connection Pool tới PostgreSQL
DATABASE_URL=postgres://zt_admin:SecurePassword123!@postgres:5432/zt_serverops
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000

# --- [3. DỊCH VỤ WEB SSH BASTION PTY] ---
# Đường dẫn tệp khóa định danh riêng tư Ed25519 (phân quyền chmod 400)
BASTION_SSH_KEY_PATH=./keys/bastion_id_ed25519
BASTION_DEFAULT_USER=root
BASTION_CONNECT_TIMEOUT_MS=10000

# --- [4. DỊCH VỤ QUÉT DỌN & PHÁT HIỆN SỰ CỐ (SWEEPER)] ---
# Chu kỳ quét kiểm tra trạng thái Liveness của các Endpoint Hosts (mili-giây)
SWEEPER_INTERVAL_MS=5000
# Ngưỡng thời gian không nhận được Telemetry Beacon để đánh dấu Node là OFFLINE (giây)
NODE_OFFLINE_THRESHOLD_SECONDS=30

# --- [5. DỊCH VỤ CẢNH BÁO ON-CALL TELEGRAM] ---
# Token tạo từ @BotFather (Tùy chọn khi bật tính năng thông báo)
TELEGRAM_BOT_TOKEN=
# Mã OTP dùng để ghép nối tài khoản Telegram với quyền nhận cảnh báo
# CHÚ THÍCH THIẾT LẬP: Nhập mã này trên điện thoại qua lệnh: /pair <MÃ_OTP>
TELEGRAM_PAIR_OTP=889900

# --- [6. MẠNG TRUYỀN DẪN NGẦM WIREGUARD] ---
WG_GATEWAY_IP=10.100.0.1
WG_SUBNET=10.100.0.0/24
WG_LISTEN_PORT=51820
